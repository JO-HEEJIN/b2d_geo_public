bin/
/b2d-server
/b2d-etl

# gitnexus local index (derived, 12MB+)
.gitnexus/

# caveman installer artifacts (skill lives in ~/.claude/skills)
.aider-desk/
skills-lock.json

# OS
.DS_Store

# editor
.idea/
.vscode/
